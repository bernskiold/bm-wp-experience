{
	"name": "bm-wp-experience",
	"version": "4.0.0",
	"description": "Provides an opinionated WordPress experience with clean-up and tweaks that we at Bernskiold have found runs WordPress best.",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"dev": "wp-scripts start",
		"start": "wp-scripts start",
		"i18n": "npm run i18n:pot",
		"i18n:pot": "wp i18n make-pot . ./languages/bm-wp-experience.pot --exclude=node_modules,vendor,assets/styles/dist",
		"check-engines": "wp-scripts check-engines",
		"lint:js": "wp-scripts lint-js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bernskiold/bm-wp-experience.git"
	},
	"author": {
		"name": "Bernskiold",
		"email": "info@bernskiold.com",
		"url": "https://bernskiold.com"
	},
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=26",
		"npm": ">=11"
	},
	"devDependencies": {
		"@wordpress/dependency-extraction-webpack-plugin": "^7.1.0",
		"@wordpress/scripts": "^37.1.0",
		"globals": "^17.14.0",
		"webpack-remove-empty-scripts": "^1.1.1"
	}
}
