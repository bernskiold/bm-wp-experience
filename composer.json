{
  "name": "bernskioldmedia/bm-wp-experience",
  "description": "Provides an opinionated WordPress experience with clean-up and tweaks that we at Bernskiold have found runs WordPress best.",
  "type": "wordpress-plugin",
  "config": {
	"sort-packages": true,
	"optimize-autoloader": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "^7.4|^8.0",
    "bacon/bacon-qr-code": "^2.0",
    "composer/installers": "~1.0",
    "postal/postal": "^1.0",
    "pragmarx/google2fa": "^8.0",
    "pragmarx/recovery": "^0.2.1",
    "yahnis-elsts/plugin-update-checker": "^4.8"
  },
  "require-dev": {
	"roave/security-advisories": "dev-latest",
	"bernskioldmedia/bm-wp-devtools": "dev-main"
  },
  "license": "GPL-3.0+",
  "authors": [
	{
	  "name": "Bernskiold",
	  "email": "info@bernskiold.com"
	}
  ],
  "autoload": {
	"psr-4": {
	  "BernskioldMedia\\WP\\Experience\\": "src"
	}
  },
  "scripts": {
	"lint": "php-cs-fixer fix -v src",
	"test:cs": "phpcs-wp",
	"test:types": "phpstan analyse --ansi --memory-limit=-1",
	"test:lint": "php-cs-fixer fix -v --dry-run src",
	"test": [
	  "@test:lint",
	  "@test:types"
	],
	"release": [
	  "npm install",
	  "npm run release",
	  "composer install",
	  "@build",
	  "composer install --no-dev -o"
	],
	"build": [
	  "composer dump-autoload"
	]
  }
}
