{
  "name": "bernskiold/bm-wp-experience",
  "description": "Provides an opinionated WordPress experience with clean-up and tweaks that we at Bernskiold have found runs WordPress best.",
  "type": "wordpress-plugin",
  "config": {
	"sort-packages": true,
	"optimize-autoloader": true,
	"platform": {
	  "php": "8.2"
	},
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "^8.2",
    "bacon/bacon-qr-code": "^3.0",
    "composer/installers": "^2.0",
    "postal/postal": "^2.0",
    "pragmarx/google2fa": "^9.0",
    "pragmarx/recovery": "^0.2.1",
    "yahnis-elsts/plugin-update-checker": "^5.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.0",
    "roave/security-advisories": "dev-latest",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "license": "GPL-3.0-or-later",
  "authors": [
	{
	  "name": "Bernskiold",
	  "email": "info@bernskiold.com"
	}
  ],
  "autoload": {
	"psr-4": {
	  "Bernskiold\\WP\\Experience\\": "src"
	}
  },
  "scripts": {
	"lint": "php-cs-fixer fix -v src",
	"test:types": "phpstan analyse --ansi --memory-limit=-1",
	"test:lint": "php-cs-fixer fix -v --dry-run src",
	"test": [
	  "@test:lint",
	  "@test:types"
	],
	"release": [
	  "npm install",
	  "npm run release",
	  "composer install --no-dev -o"
	]
  }
}
